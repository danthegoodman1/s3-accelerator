          "let expired: Vec<EventId> = self.events.iter().filter(|(_, (_, until))| *until <= now).map(|(event, _)| *event).collect();\n"
          "        for event in expired { self.events.remove(&event); self.actions.push(Action::EventDone { event }); }")],
    ),
    (
        "an event for the version the home holds drops it",
        [(NODE, "&& meta.etag == *etag\n        {\n            return;\n        }", "&& meta.etag == *etag && false\n        {\n            return;\n        }")],
    ),
    (
        "a home ignores an event another node passed on",
        [(NODE, "self.now = self.now.max(now);\n        self.change_to(now, key, etag);\n    }", "self.now = self.now.max(now);\n        let _ = (key, etag);\n    }")],
    ),
    (
        "a home ignores an event notice from another node",
        [(NODE_ENGINE, "NodeEngine::event_notice(engine, &key, etag.as_ref());", "let _ = (&key, &etag);")],
    ),
    (
        "a finished event's message stays in the queue",
        [(NODE_ENGINE, "self.work.deletes.push(receipt);", "let _ = receipt;")],
    ),
    (
        "event queue requests are signed for S3",
        [(SQS, 'service: "sqs",', 'service: "s3",')],
    ),
    (
        "an event's key keeps its + for a space",
        [(SQS, "percent_decode_str(&key.replace('+', \" \"))", "percent_decode_str(key)")],
    ),
    (
        "a stand-in for the home trusts its own ring",
        [(GATEWAY, "&& self.ring.owner(*placement) != Some(node)\n        {\n            *direct = true;", "&& self.ring.owner(*placement) != Some(node)\n        {\n            let _ = direct;")],
    ),
    (
        "a lease never runs out",
        [(NODE, "let busy = hot.reads * window * 2 >= self.config.hot_threshold * period;", "let busy = period > 0;")],
    ),
    (
        "a gateway ignores hot hints",
        [(GATEWAY, "self.hot\n                .insert(hint.placement, (hint.nodes, hint.until, next));", "let _ = next;")],
    ),
    (
        "a replica never fills from the owner",
        [(NODE, "false => self.lease_owner(placement),", "false => None,")],
    ),
    (
        "a replica never stores a leased placement's blocks",
        [(NODE, "if self.ring.owner(placement) != Some(self.id) && !self.leased(placement) {", "if self.ring.owner(placement) != Some(self.id) {")],
    ),
    (
        "a kept upload is stored without the ETag check",
        [(NODE, "let current = head.status == 200\n            && head.etag.as_ref() == Some(&etag)", "let current = head.status == 200")],
    ),
    (
        "the home keeps no upload",
        [(NODE_ENGINE, "let region = this.node.warm_region(key, len);", "let region: Vec<Range<u64>> = Vec::new();")],
    ),
    (
        "a home never prefetches metadata",
        [(NODE, "self.prefetch(&key, &etag, size, version, span);\n        }\n        self.unref(version);", "let _ = span;\n        }\n        self.unref(version);")],
    ),
    (
        "a spot's blocks wait for the doorkeeper",
        [(NODE, "&& !at_spot", "&& !(at_spot && false)")],
    ),
    (
        "a first fetch of a spot stores none of it",
        [(NODE, "self.prefetch(&key, &meta.etag, meta.size, version, spot);", "let _ = spot;")],
    ),
    (
        "spot reads come back empty",
        [(NODE_ENGINE, "Ok(Ok(bytes)) => bytes,\n                    _ => Vec::new(),", "_ => Vec::new(),")],
    ),
    (
        "a purge an owner missed while down is never told again",
        [(NODE, "self.pass_purge(&key, &nodes);", "let _ = nodes;")],
    ),
    (
        "a restarted coordinator forgets its purges",
        [(NODE, "false => node\n                    .purges\n                    .insert(key, (nodes.into_iter().collect(), Time::default())),",
          "false => {\n                    let _ = (key, nodes);\n                    None\n                }")],
    ),
    (
        "a purge keeps the records of blocks being read",
        [(NODE, "if entry.state == BlockState::Ready {\n                    let location = entry.location;\n                    self.actions.push(Action::Clear { location });",
          "if entry.state == BlockState::Ready && !entry.pinned() {\n                    let location = entry.location;\n                    self.actions.push(Action::Clear { location });")],
    ),
    (
        "a purge tells nodes out of every ring",
        [(NODE, ".filter(|&node| self.in_rings(node))", ".filter(|&node| node.0 < u64::MAX)")],
    ),
]


def main():
    # SIGTERM unwinds like Ctrl-C, so each step's cleanup runs.
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(1))
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--seeds", type=int, default=300)
    parser.add_argument("--only")
    parser.add_argument("--check", action="store_true", help="only check that every mutant applies")
    args = parser.parse_args()

    root = Path(__file__).resolve().parent.parent
    work = root / "target" / "mutants"
    copy = work / "src"
    target = work / "target"
    results = []
    if args.check:
        broken = 0
        for name, replacements in MUTANTS:
            if args.only and args.only != name:
                continue
            for path, old, new in replacements:
                count = len(list(re.finditer(pattern(old), (root / path).read_text())))
                if count != 1:
                    print(f"{name}: {count} matches in {path}")
                    broken += 1
        sys.exit(1 if broken else 0)
    for name, replacements in MUTANTS:
        if args.only and args.only != name:
            continue
        print(f"== {name}", flush=True)
        if copy.exists():
            shutil.rmtree(copy)
        # Fresh modification times make cargo rebuild every workspace crate,
        # so no crate keeps the previous mutant's build.
        shutil.copytree(root, copy, ignore=shutil.ignore_patterns("target", ".git"),
                        copy_function=shutil.copy)
        for path, old, new in replacements:
            file = copy / path
            text = file.read_text()
            matches = list(re.finditer(pattern(old), text))
            if len(matches) != 1:
                sys.exit(f"{name}: expected one match in {path}, found {len(matches)}, for:\n{old}")
            match = matches[0]
            file.write_text(text[: match.start()] + new + text[match.end() :])
        results.append((name, catch(copy, target, args.seeds)))

    print()
    width = max(len(name) for name, _ in results)
    for name, outcome in results:
        print(f"{name:<{width}}  {outcome}")
    if any(outcome in ("MISSED", "did not build") for _, outcome in results):
        sys.exit(1)


def pattern(old):
    """A regex for `old` that ignores whitespace."""
    return r"\s*".join(re.escape(char) for char in old if not char.isspace())


def catch(copy, target, seeds):
    """Which layer catches the mutant, or MISSED."""
    env = {"CARGO_TARGET_DIR": str(target)}
    build = run(copy, env, ["cargo", "build", "-q", "--release", "--workspace", "--tests", "--bins"])
    if build is None or build.returncode != 0:
        print(build.stderr[-2000:] if build else "build timed out")
        return "did not build"
    layers = [
        ("core unit tests", ["cargo", "test", "-q", "--release", "-p", "s3-accelerator-core"]),
        ("server tests", ["cargo", "test", "-q", "--release", "-p", "s3-accelerator"]),
        ("sim tests", ["cargo", "test", "-q", "--release", "-p", "s3-accelerator-sim"]),
        ("seeds", ["cargo", "run", "-q", "--release", "-p", "s3-accelerator-sim", "--", "0",
                   "--seeds", str(seeds)]),
    ]
    for layer, command in layers:
        result = run(copy, env, command)
        if result is None:
            return f"caught by {layer} (hung)"
        if result.returncode != 0:
            if os.environ.get("MUTANTS_VERBOSE"):
                print(result.stdout[-3000:], result.stderr[-3000:])
            summary = next((line for line in result.stdout.splitlines() if " seeds from " in line), "")
            return f"caught by {layer}" + (f" ({summary})" if summary else "")
    return "MISSED"


def run(cwd, env, command):
    """The finished process, or None if it ran past the step timeout. The
    step runs in its own process group, which is killed however the step
    ends, so a hung test binary never outlives it."""
    process = subprocess.Popen(command, cwd=cwd, env={**os.environ, **env},
                               stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                               start_new_session=True)
    try:
        stdout, stderr = process.communicate(timeout=STEP_TIMEOUT)
        return subprocess.CompletedProcess(command, process.returncode, stdout, stderr)
    except subprocess.TimeoutExpired:
        return None
    finally:
        try:
            os.killpg(process.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
        process.wait()


if __name__ == "__main__":
    main()
