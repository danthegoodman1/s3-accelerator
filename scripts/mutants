#!/usr/bin/env python3
"""Plants known bugs, one at a time, in a scratch copy of the workspace and
reports whether the core's unit tests, the server's tests, the simulator's
tests (scenarios and regression seeds) or a seed sweep catch each one.

    scripts/mutants [--seeds N] [--only NAME] [--check]

A mutant is a list of replacements; each must match exactly once, ignoring
whitespace, so formatting changes leave the mutants intact. The copy lives
in target/mutants/src and shares one target directory: dependencies build
once, and every workspace crate rebuilds for each mutant. A step that hangs counts as a catch. Exits
non-zero if any mutant goes uncaught or fails to build.
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

NODE = "crates/core/src/node.rs"
STORE = "crates/core/src/store.rs"
GATEWAY = "crates/core/src/gateway.rs"
SERVER = "crates/server/src/server.rs"
STEP_TIMEOUT = 600

MUTANTS = [
    (
        "fill accepts any version",
        [
            (NODE, "if_match: Some(etag.clone()),", "if_match: None,"),
            (NODE, "&& head.etag.as_ref() == Some(etag)", ""),
        ],
    ),
    (
        "hit reads the wrong offset in its slot",
        [(NODE, "let offset = piece.start - span.start;", "let offset = 0;")],
    ),
    (
        "ttl metadata served past its age",
        [(NODE, "Freshness::Ttl(ttl) => validated.0 + ttl >= arrived.0,", "Freshness::Ttl(_) => true,")],
    ),
    (
        "doorkeeper admits on the first read",
        [(NODE, "if !self.policy(&key.bucket).admit_on_first_read && !self.doorkeeper.contains(hash) {", "if false {")],
    ),
    (
        "response leaves its blocks unpinned",
        [(NODE, "self.store.pin(block);\n                holds.pins.push(block);", "")],
    ),
    (
        "write leaves its body unheld",
        [
            (NODE, 'self.origins.get_mut(&origin).expect("written body exists").readers += 1;', ""),
            (NODE, "self.stats.written_bytes += len;\n        if self.in_flight.get(&block) == Some(&origin) {\n            self.in_flight.remove(&block);\n            self.unref(block.version);\n        }\n        self.stop_reading(origin);",
             "self.stats.written_bytes += len;\n        if self.in_flight.get(&block) == Some(&origin) {\n            self.in_flight.remove(&block);\n            self.unref(block.version);\n        }"),
        ],
    ),
    (
        "first fetch body read from the wrong offset",
        [(NODE, 'self.origins.get_mut(&origin).expect("answered origin").body_start = first;', "")],
    ),
    (
        "416 relayed despite preconditions",
        [(NODE, "if relay && head.status == 416 && conditional {", "if false {")],
    ),
    (
        "stale request sent back twice",
        [(NODE, "// A request awaiting several failed fills goes back once.\n        let Some(waiting) = self.waiting.remove(&id) else {\n            return;\n        };",
          'let waiting = self.waiting.remove(&id).expect("a stale request was waiting");')],
    ),
    (
        "revalidation keeps the old metadata",
        [(NODE, "(200, Some(fresh)) => {\n                *meta = fresh;\n                *validated = sent;\n            }",
          "(200, Some(_)) => *validated = sent,")],
    ),
    (
        "concurrent first reads fetch separately",
        [(NODE, "Some(Object::Fetching { waiting, .. }) => waiting.push(id),",
          "Some(Object::Fetching { .. }) => self.first_fetch(now, id, Request::get(key.clone()), Vec::new(), true),")],
    ),
    (
        "ghost queue ignored",
        [(STORE, "if self.ghosts.contains_key(&entry.hash) {", "if false {")],
    ),
    (
        "fill budget ignored",
        [(NODE, "if self.filling_bytes + len > self.config.fill_budget {", "if false {")],
    ),
    (
        "a pinned main queue blocks the small queue",
        [(STORE, "(false, true) => true,", "(false, true) => self.small_bytes > small_target,")],
    ),
    (
        "a write leaves the home's metadata in place",
        [(NODE, "Some(Object::Known { .. }) => {\n                if let Some(Object::Known {", "Some(Object::Known { .. }) => {\n                if false && let Some(Object::Known {")],
    ),
    (
        "a first fetch sent before a write is kept",
        [(NODE, "Some(Object::Fetching { superseded, .. }) => *superseded = true,", "Some(Object::Fetching { .. }) => {}")],
    ),
    (
        "a copy's source is not checked against the grants",
        [(SERVER, 'if let Some(source) = header(&head.headers, "x-amz-copy-source") {',
          "if let Some(source) = None::<&str> {")],
    ),
    (
        "bodies are read whatever their size",
        [(SERVER, "if len > context.max_body {", "if false {")],
    ),
    (
        "DeleteObjects leaves cached metadata",
        [(SERVER, "return listed_keys(&String::from_utf8_lossy(body));", "return Vec::new();")],
    ),
    (
        "dot-segment keys reach S3",
        [(SERVER, 'if key.split(\'/\').any(|segment| segment == "." || segment == "..") {', "if false {")],
    ),
    (
        "parts assembled out of order",
        [(GATEWAY, "let (head, parts) = (planned.clone(), parts.clone());",
          "let (head, parts) = (planned.clone(), parts.iter().rev().copied().collect());")],
    ),
    (
        "a stale gateway entry is kept",
        [(GATEWAY, "self.cache.remove(&key);\n        self.plan(now, id);", "self.plan(now, id);")],
    ),
    (
        "nodes store blocks they do not own",
        [(NODE, "if self.ring.owner(placement) != Some(self.id) {", "if false {")],
    ),
    (
        "gateway metadata used past the bucket's ttl",
        [(GATEWAY, "cached.validated.0 + bucket_ttl >= arrived.0 && cached.received.0 + ttl >= arrived.0",
          "cached.received.0 + ttl >= arrived.0")],
    ),
    (
        "the home serves blocks it does not hold",
        [(NODE, "if beyond_home {", "if false {")],
    ),
    (
        "the proxying gateway keeps its entry after a write",
        [(GATEWAY, "self.cache.written(key, now);", "let _ = (key, now);")],
    ),
    (
        "an answer older than a write restores the gateway's entry",
        [(GATEWAY, "Some(entry) if sent < entry.written => return,", "")],
    ),
    (
        "the gateway sends preconditions to the home",
        [(GATEWAY, "if !direct && let Some(cached) = self.cache.fresh(&key, arrived, policy, ttl) {",
          "if !direct && self.reads[&id].request.if_none_match.is_none() && let Some(cached) = self.cache.fresh(&key, arrived, policy, ttl) {")],
    ),
    (
        "a read that keeps finding its object changed never goes direct",
        [(GATEWAY, "let direct = read.retries >= STALE_RETRIES;", "let direct = false;")],
    ),
    (
        "the home ignores stale reports",
        [(NODE, "stale.take().is_some_and(|stale| stale == meta.etag)", "false")],
    ),
    (
        "metadata never forgotten",
        [(NODE, "while self.recency.len() > self.config.metadata_capacity && kept < self.recency.len() {",
          "while false {")],
    ),
]


def main():
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--seeds", type=int, default=300)
    parser.add_argument("--only")
    parser.add_argument("--check", action="store_true", help="only check that every mutant applies")
    args = parser.parse_args()

    root = Path(__file__).resolve().parent.parent
    work = root / "target" / "mutants"
    copy = work / "src"
    target = work / "target"
    results = []
    if args.check:
        broken = 0
        for name, replacements in MUTANTS:
            if args.only and args.only != name:
                continue
            for path, old, new in replacements:
                count = len(list(re.finditer(pattern(old), (root / path).read_text())))
                if count != 1:
                    print(f"{name}: {count} matches in {path}")
                    broken += 1
        sys.exit(1 if broken else 0)
    for name, replacements in MUTANTS:
        if args.only and args.only != name:
            continue
        print(f"== {name}", flush=True)
        if copy.exists():
            shutil.rmtree(copy)
        # Fresh modification times make cargo rebuild every workspace crate,
        # so no crate keeps the previous mutant's build.
        shutil.copytree(root, copy, ignore=shutil.ignore_patterns("target", ".git"),
                        copy_function=shutil.copy)
        for path, old, new in replacements:
            file = copy / path
            text = file.read_text()
            matches = list(re.finditer(pattern(old), text))
            if len(matches) != 1:
                sys.exit(f"{name}: expected one match in {path}, found {len(matches)}, for:\n{old}")
            match = matches[0]
            file.write_text(text[: match.start()] + new + text[match.end() :])
        results.append((name, catch(copy, target, args.seeds)))

    print()
    width = max(len(name) for name, _ in results)
    for name, outcome in results:
        print(f"{name:<{width}}  {outcome}")
    if any(outcome in ("MISSED", "did not build") for _, outcome in results):
        sys.exit(1)


def pattern(old):
    """A regex for `old` that ignores whitespace."""
    return r"\s*".join(re.escape(char) for char in old if not char.isspace())


def catch(copy, target, seeds):
    """Which layer catches the mutant, or MISSED."""
    env = {"CARGO_TARGET_DIR": str(target)}
    build = run(copy, env, ["cargo", "build", "-q", "--release", "--workspace", "--tests", "--bins"])
    if build is None or build.returncode != 0:
        print(build.stderr[-2000:] if build else "build timed out")
        return "did not build"
    layers = [
        ("core unit tests", ["cargo", "test", "-q", "--release", "-p", "s3-accelerator-core"]),
        ("server tests", ["cargo", "test", "-q", "--release", "-p", "s3-accelerator"]),
        ("sim tests", ["cargo", "test", "-q", "--release", "-p", "s3-accelerator-sim"]),
        ("seeds", ["cargo", "run", "-q", "--release", "-p", "s3-accelerator-sim", "--", "0",
                   "--seeds", str(seeds)]),
    ]
    for layer, command in layers:
        result = run(copy, env, command)
        if result is None:
            return f"caught by {layer} (hung)"
        if result.returncode != 0:
            if os.environ.get("MUTANTS_VERBOSE"):
                print(result.stdout[-3000:], result.stderr[-3000:])
            summary = next((line for line in result.stdout.splitlines() if " seeds from " in line), "")
            return f"caught by {layer}" + (f" ({summary})" if summary else "")
    return "MISSED"


def run(cwd, env, command):
    """The finished process, or None if it ran past the step timeout."""
    try:
        return subprocess.run(command, cwd=cwd, env={**os.environ, **env}, capture_output=True,
                              text=True, timeout=STEP_TIMEOUT)
    except subprocess.TimeoutExpired:
        return None


if __name__ == "__main__":
    main()
