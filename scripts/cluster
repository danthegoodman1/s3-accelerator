#!/usr/bin/env bash
# Runs a cluster of separate processes in front of the s3proxy that
# `scripts/s3proxy` runs: storage nodes on 127.0.0.1:9101 and up, which
# alone hold S3 credentials, and a gateway on 127.0.0.1:9000 that takes
# s3proxy's credentials from clients, so the conformance suite runs
# unchanged. Configs, disks and logs go in target/cluster.
#
#   scripts/cluster start [NODES] [--tls] [--metadata]   # build, start, and wait until it answers
#   scripts/cluster stop                                 # shut every process down cleanly
#
# With --tls, the gateway serves HTTPS with a self-signed certificate in
# target/cluster/tls, which clients trust through SSL_CERT_FILE, and every
# process reaches nodes over mutual TLS with a certificate a CA made there
# signed.
#
# With --metadata, nodes look up every bucket's origin in the reference
# metadata service on 127.0.0.1:9200, which names s3proxy as each one's.
set -euo pipefail

dir=target/cluster
binary=target/debug/s3-accelerator

s3proxy='endpoint = "http://localhost:'"${S3PROXY_PORT:-8080}"'"
region = "us-east-1"
access_key_id = "local-identity"
secret_access_key = "local-credential"'
origin="[origin]
$s3proxy"

config() {
  local nodes=$1 role=$2
  cat <<TOML
[[clients]]
access_key_id = "local-identity"
secret_access_key = "local-credential"
grants = [{ bucket = "*", access = "admin" }]

[cache]
block_size = 65536
chunk_blocks = 4
extent_size = 1048576
extents = 16

[cluster]
secret = "cluster-secret"
nodes = [$(for id in $(seq 0 $((nodes - 1))); do printf '{ id = %d, address = "127.0.0.1:%d" }, ' "$id" $((9101 + id)); done)]

$role
TOML
}

wait_for() {
  local port=$1
  for _ in $(seq 120); do
    if (: <"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
      return
    fi
    sleep 0.5
  done
  echo "nothing answered on port $port" >&2
  exit 1
}

case "${1:-}" in
  start)
    nodes=3
    tls=
    metadata=
    for arg in "${@:2}"; do
      case "$arg" in
        --tls) tls=--tls ;;
        --metadata) metadata=--metadata ;;
        *) nodes=$arg ;;
      esac
    done
    cargo build -q -p s3-accelerator
    rm -rf "$dir"
    mkdir -p "$dir"
    if [ "$metadata" = --metadata ]; then
      cat >"$dir/metadata.toml" <<TOML
listen = "127.0.0.1:9200"
token = "metadata-token"
nodes = [$(for id in $(seq 0 $((nodes - 1))); do printf '"127.0.0.1:%d", ' $((9091 + id)); done)]

[default]
$s3proxy
TOML
      target/debug/s3-accelerator-metadata "$dir/metadata.toml" >"$dir/metadata.log" 2>&1 &
      echo $! >"$dir/metadata.pid"
      wait_for 9200
      origin='[metadata]
url = "http://127.0.0.1:9200"
token = "metadata-token"'
    fi
    members=
    if [ "$tls" = --tls ]; then
      tls_dir="$dir/tls"
      mkdir -p "$tls_dir"
      ec=(-newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes)
      openssl req -x509 "${ec[@]}" -days 1 -subj "/CN=cluster CA" \
        -keyout "$tls_dir/ca-key.pem" -out "$tls_dir/ca.pem" 2>/dev/null
      openssl req "${ec[@]}" -subj /CN=member \
        -keyout "$tls_dir/member-key.pem" -out "$tls_dir/member.csr" 2>/dev/null
      printf 'subjectAltName=IP:127.0.0.1\nbasicConstraints=critical,CA:FALSE\n' >"$tls_dir/member.ext"
      openssl x509 -req -in "$tls_dir/member.csr" -CA "$tls_dir/ca.pem" -CAkey "$tls_dir/ca-key.pem" \
        -days 1 -extfile "$tls_dir/member.ext" -out "$tls_dir/member.pem" 2>/dev/null
      members="
[cluster.tls]
ca = \"$tls_dir/ca.pem\"
cert = \"$tls_dir/member.pem\"
key = \"$tls_dir/member-key.pem\""
    fi
    for id in $(seq 0 $((nodes - 1))); do
      config "$nodes" "$origin

[node]
id = $id
data_dir = \"$dir/node-$id\"

[admin]
listen = \"127.0.0.1:$((9091 + id))\"
$members" >"$dir/node-$id.toml"
      "$binary" "$dir/node-$id.toml" >"$dir/node-$id.log" 2>&1 &
      echo $! >"$dir/node-$id.pid"
      wait_for $((9101 + id))
    done
    gateway='[gateway]
listen = "127.0.0.1:9000"
domains = ["localhost"]

[admin]
listen = "127.0.0.1:9090"'
    if [ "$tls" = --tls ]; then
      # Rustls matches no wildcard over a single label, so the certificate
      # names the bucket the conformance suite reaches virtual-hosted-style.
      openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
        -days 1 -subj /CN=127.0.0.1 -addext subjectAltName=IP:127.0.0.1,DNS:localhost,DNS:virtual-hosted.localhost \
        -addext basicConstraints=critical,CA:FALSE \
        -keyout "$dir/tls/key.pem" -out "$dir/tls/cert.pem" 2>/dev/null
      gateway="$gateway

[gateway.tls]
cert = \"$dir/tls/cert.pem\"
key = \"$dir/tls/key.pem\"
$members"
    fi
    config "$nodes" "$gateway" >"$dir/gateway.toml"
    "$binary" "$dir/gateway.toml" >"$dir/gateway.log" 2>&1 &
    echo $! >"$dir/gateway.pid"
    wait_for 9000
    echo "a gateway and $nodes nodes are listening; logs are in $dir"
    echo "metrics at http://127.0.0.1:9090/metrics for the gateway and 9091 on for the nodes"
    if [ "$tls" = --tls ]; then
      echo "clients trust the gateway with SSL_CERT_FILE=$PWD/$dir/tls/cert.pem"
    fi
    ;;
  stop)
    for pid in "$dir"/*.pid; do
      kill -TERM "$(cat "$pid")" 2>/dev/null || true
      rm -f "$pid"
    done
    ;;
  *)
    echo "usage: $0 start [NODES] [--tls] [--metadata]|stop" >&2
    exit 2
    ;;
esac
